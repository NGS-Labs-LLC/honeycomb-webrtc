+/*
+ * honeycomb-webrtc patch (SEC PR-01; hive-node wire-protocol.md 6.6 "Replay",
+ * D-075, D-086; honeycomb-ios D156). Licensed under the Apache License,
+ * Version 2.0, as the file next to it.
+ */
+
+#include "api/crypto/frame_replay_guard.h"
+
+#include <stdint.h>
+
+#include <array>
+#include <vector>
+
+#include "test/gtest.h"
+
+namespace webrtc {
+namespace {
+
+constexpr uint32_t kWindow = FrameReplayGuard::kAudioWindowTicks;
+
+std::array<uint8_t, 12> Iv(uint32_t ssrc, uint32_t ts, uint32_t tail = 0) {
+  std::array<uint8_t, 12> iv{};
+  const uint32_t words[3] = {ssrc, ts, tail};
+  for (int w = 0; w < 3; ++w) {
+    for (int b = 0; b < 4; ++b) {
+      iv[w * 4 + b] = static_cast<uint8_t>(words[w] >> (24 - 8 * b));
+    }
+  }
+  return iv;
+}
+
+bool Accept(FrameReplayGuard& guard, uint32_t ssrc, uint32_t ts,
+            uint32_t tail = 0) {
+  const auto iv = Iv(ssrc, ts, tail);
+  return guard.Accept(iv, kWindow);
+}
+
+TEST(FrameReplayGuard, RepeatedIvIsRefusedAndLateFrameInsideWindowPlays) {
+  FrameReplayGuard guard;
+  EXPECT_TRUE(Accept(guard, 1, 1000));
+  EXPECT_TRUE(Accept(guard, 1, 3000));
+  EXPECT_TRUE(Accept(guard, 1, 2000));  // late, inside the window
+  EXPECT_FALSE(Accept(guard, 1, 1000));
+  EXPECT_FALSE(Accept(guard, 1, 3000));
+  EXPECT_FALSE(Accept(guard, 1, 2000));
+  // Same timestamp, other IV tail: another frame, so it plays.
+  EXPECT_TRUE(Accept(guard, 1, 2000, 7));
+}
+
+TEST(FrameReplayGuard, MoreThanTheWindowBehindIsRefused) {
+  FrameReplayGuard guard;
+  EXPECT_TRUE(Accept(guard, 1, 10 * kWindow));
+  EXPECT_TRUE(Accept(guard, 1, 9 * kWindow));       // exactly the window
+  EXPECT_FALSE(Accept(guard, 1, 9 * kWindow - 1));  // one tick more
+}
+
+// D-086: a window-behind run of any length never reopens the ssrc. The SFU
+// withholds the live frames and sends old ones; every one stays refused, and
+// so does the old stream continuing from there.
+TEST(FrameReplayGuard, WindowBehindRunOfAnyLengthNeverReopens) {
+  FrameReplayGuard guard;
+  const uint32_t live = 100 * kWindow;
+  for (uint32_t i = 0; i < 50; ++i) {
+    ASSERT_TRUE(Accept(guard, 1, i * 960));
+  }
+  ASSERT_TRUE(Accept(guard, 1, live));
+  for (uint32_t i = 0; i < 100000; ++i) {
+    ASSERT_FALSE(Accept(guard, 1, (i % 50) * 960, i)) << "frame " << i;
+  }
+  for (uint32_t i = 0; i < 1000; ++i) {
+    ASSERT_FALSE(Accept(guard, 1, 50 * 960 + i * 960)) << "continuation " << i;
+  }
+  // The live stream still plays.
+  EXPECT_TRUE(Accept(guard, 1, live + 960));
+}
+
+// D-086 review: eviction is not a reset. The ssrc heard from longest ago is
+// replaced, retired, and refused for the rest of the key's life, whatever
+// timestamp its frames carry.
+TEST(FrameReplayGuard, EvictedSsrcIsRetiredForTheKeysLife) {
+  FrameReplayGuard guard;
+  for (uint32_t ssrc = 1; ssrc <= FrameReplayGuard::kMaxSsrcs; ++ssrc) {
+    ASSERT_TRUE(Accept(guard, ssrc, 1000));
+  }
+  for (uint32_t ssrc = 2; ssrc <= FrameReplayGuard::kMaxSsrcs; ++ssrc) {
+    ASSERT_TRUE(Accept(guard, ssrc, 2000));
+  }
+  ASSERT_TRUE(Accept(guard, 100, 1000));  // a 17th: ssrc 1 is the oldest
+  EXPECT_EQ(guard.ssrc_count(), FrameReplayGuard::kMaxSsrcs);
+  EXPECT_EQ(guard.retired_count(), 1u);
+  EXPECT_FALSE(Accept(guard, 1, 1000));  // its old frame
+  EXPECT_FALSE(Accept(guard, 1, 500));   // anything older
+  EXPECT_FALSE(Accept(guard, 1, 50 * kWindow));  // or newer
+  for (uint32_t i = 0; i < 1000; ++i) {
+    ASSERT_TRUE(Accept(guard, 100, 3000 + i * 960));
+    ASSERT_FALSE(Accept(guard, 1, i * 960, i));
+  }
+  EXPECT_EQ(guard.retired_count(), 1u);  // refusing it never re-adds it
+}
+
+// Refused frames don't refresh an ssrc, so a replaying SFU can't choose
+// which live ssrc is evicted by repeating its frames.
+TEST(FrameReplayGuard, RefusedFramesDoNotKeepAnSsrcFresh) {
+  FrameReplayGuard guard;
+  for (uint32_t ssrc = 1; ssrc <= FrameReplayGuard::kMaxSsrcs; ++ssrc) {
+    ASSERT_TRUE(Accept(guard, ssrc, 1000));
+  }
+  for (int i = 0; i < 10; ++i) {
+    ASSERT_FALSE(Accept(guard, 1, 1000));  // replays of ssrc 1
+  }
+  ASSERT_TRUE(Accept(guard, 100, 1000));
+  EXPECT_FALSE(Accept(guard, 1, 2000));   // ssrc 1 was still the oldest
+  EXPECT_TRUE(Accept(guard, 2, 2000));
+}
+
+// At most kMaxRetired retired; past that a frame of any ssrc the guard does
+// not hold is refused, and the live ssrcs keep playing.
+TEST(FrameReplayGuard, PastTheRetiredBoundUnknownSsrcsAreRefused) {
+  FrameReplayGuard guard;
+  uint32_t ssrc = 1;
+  for (; guard.retired_count() < FrameReplayGuard::kMaxRetired; ++ssrc) {
+    ASSERT_TRUE(Accept(guard, ssrc, 1000));
+  }
+  // Fill up to the live bound once more so the next new ssrc needs an
+  // eviction.
+  while (guard.ssrc_count() < FrameReplayGuard::kMaxSsrcs) {
+    ASSERT_TRUE(Accept(guard, ssrc++, 1000));
+  }
+  EXPECT_EQ(guard.retired_count(), FrameReplayGuard::kMaxRetired);
+  EXPECT_FALSE(Accept(guard, 0xF0000000u, 1000));
+  EXPECT_EQ(guard.ssrc_count(), FrameReplayGuard::kMaxSsrcs);
+  EXPECT_EQ(guard.retired_count(), FrameReplayGuard::kMaxRetired);
+  EXPECT_FALSE(Accept(guard, 1, 5000));  // retired stays retired
+  EXPECT_TRUE(Accept(guard, ssrc - 1, 2000));  // a live one plays
+}
+
+TEST(FrameReplayGuard, TimestampWrapsBySerialArithmetic) {
+  FrameReplayGuard guard;
+  EXPECT_TRUE(Accept(guard, 1, 0xFFFFFF00u));
+  EXPECT_TRUE(Accept(guard, 1, 0x00000100u));  // past the wrap: newer
+  EXPECT_FALSE(Accept(guard, 1, 0xFFFFFF00u));
+  EXPECT_TRUE(Accept(guard, 1, 0xFFFFFF80u));  // late, inside the window
+  EXPECT_FALSE(Accept(guard, 1, 0x00000100u - kWindow - 1));
+}
+
+TEST(FrameReplayGuard, OnlyWindowIvsAreRemembered) {
+  FrameReplayGuard guard;
+  for (uint32_t i = 0; i < 1000; ++i) {
+    ASSERT_TRUE(Accept(guard, 1, i * 960));
+  }
+  // 96 000 ticks of 960 apart: the newest and the 100 behind it.
+  EXPECT_EQ(guard.remembered(1), 101u);
+}
+
+TEST(FrameReplayGuard, IvOfAnotherLengthIsRefused) {
+  FrameReplayGuard guard;
+  const std::vector<uint8_t> short_iv(11, 0);
+  const std::vector<uint8_t> long_iv(13, 0);
+  EXPECT_FALSE(guard.Accept(short_iv, kWindow));
+  EXPECT_FALSE(guard.Accept(long_iv, kWindow));
+  EXPECT_EQ(guard.ssrc_count(), 0u);
+}
+
+// honeycomb-ios D156: the key index a played frame decrypted under is
+// reported for the first played frame, then only when it changes.
+TEST(DecryptedKeyIndexReport, ReportsTheFirstIndexAndEachChange) {
+  DecryptedKeyIndexReport report;
+  std::vector<int> reported;
+  for (int index : {0, 0, 0, 1, 1, 0, 1, 1, 2, 2}) {
+    if (report.Changed(index)) {
+      reported.push_back(index);
+    }
+  }
+  EXPECT_EQ(reported, (std::vector<int>{0, 1, 0, 1, 2}));
+}
+

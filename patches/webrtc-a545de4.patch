+/*
+ * honeycomb-webrtc patch (SEC PR-01; hive-node wire-protocol.md 6.6 "Replay",
+ * D-075). Licensed under the Apache License, Version 2.0, as the file next to it.
+ */
+
+#ifndef API_CRYPTO_FRAME_REPLAY_GUARD_H_
+#define API_CRYPTO_FRAME_REPLAY_GUARD_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <algorithm>
+#include <span>
+#include <vector>
+
+namespace webrtc {
+
+// A receiver's frame replay check for one frame key. GCM proves a frame came
+// from the key's holder, not that it is new, and an SFU can send an earlier
+// frame again under fresh RTP sequence numbers. After a frame decrypts, its
+// IV's ssrc (bytes 0-3) and timestamp (bytes 4-7) are read; per ssrc the guard
+// keeps the newest timestamp N (serial arithmetic mod 2^32, RFC 1982) and the
+// IVs within the window behind N, and refuses a frame whose IV it holds or
+// whose timestamp is more than the window behind N. The IV is authenticated by
+// GCM; the RTP header's timestamp, which the SFU rewrites, is never read.
+//
+// Bounds: at most kMaxSsrcs ssrcs (a new one replaces the one heard from
+// longest ago) and, per ssrc, the IVs within the window. An ssrc whose every
+// frame has been refused as window-behind for kResetAfterMs is reset, so a
+// sender whose own timestamp jumps back does not go silent.
+//
+// Not thread-safe; the owner holds a lock.
+class FrameReplayGuard {
+ public:
+  // 2 s of the codec's RTP clock.
+  static constexpr uint32_t kAudioWindowTicks = 96000;   // 48 kHz
+  static constexpr uint32_t kVideoWindowTicks = 180000;  // 90 kHz
+  static constexpr size_t kMaxSsrcs = 16;
+  static constexpr int64_t kResetAfterMs = 2000;
+  static constexpr size_t kIvSize = 12;
+
+  // `iv` is the 12-byte IV of a frame that decrypted under this guard's key.
+  // Returns true when the frame plays, false when it is refused (an IV of
+  // another length is refused).
+  bool Accept(std::span<const uint8_t> iv,
+              uint32_t window_ticks,
+              int64_t now_ms) {
+    if (iv.size() != kIvSize) {
+      return false;
+    }
+    const uint32_t ssrc = Read32(iv, 0);
+    const uint32_t ts = Read32(iv, 4);
+    const uint32_t tail = Read32(iv, 8);
+    ++clock_;
+    Stream* stream = Find(ssrc);
+    if (stream == nullptr) {
+      if (streams_.size() >= kMaxSsrcs) {
+        streams_.erase(std::min_element(
+            streams_.begin(), streams_.end(),
+            [](const Stream& a, const Stream& b) {
+              return a.last_heard < b.last_heard;
+            }));
+      }
+      streams_.push_back(Start(ssrc, ts, tail));
+      return true;
+    }
+    stream->last_heard = clock_;
+    if (Behind(stream->newest, ts) > window_ticks) {
+      if (!stream->behind) {
+        stream->behind = true;
+        stream->behind_since_ms = now_ms;
+        return false;
+      }
+      if (now_ms - stream->behind_since_ms < kResetAfterMs) {
+        return false;
+      }
+      *stream = Start(ssrc, ts, tail);
+      return true;
+    }
+    stream->behind = false;
+    for (const Seen& seen : stream->seen) {
+      if (seen.ts == ts && seen.tail == tail) {
+        return false;
+      }
+    }
+    if (Behind(stream->newest, ts) == 0) {
+      stream->newest = ts;
+    }
+    stream->seen.push_back(Seen{ts, tail});
+    const uint32_t newest = stream->newest;
+    stream->seen.erase(
+        std::remove_if(stream->seen.begin(), stream->seen.end(),
+                       [newest, window_ticks](const Seen& seen) {
+                         return Behind(newest, seen.ts) > window_ticks;
+                       }),
+        stream->seen.end());
+    return true;
+  }
+
+  size_t ssrc_count() const { return streams_.size(); }
+
+  size_t remembered(uint32_t ssrc) const {
+    for (const Stream& stream : streams_) {
+      if (stream.ssrc == ssrc) {
+        return stream.seen.size();
+      }
+    }
+    return 0;
+  }
+
+  // How far `ts` is behind `newest` modulo 2^32, or 0 when it is not behind.
+  static uint32_t Behind(uint32_t newest, uint32_t ts) {
+    const uint32_t d = newest - ts;
+    return d >= 0x80000000u ? 0 : d;
+  }
+
+ private:
+  struct Seen {
+    uint32_t ts;
+    uint32_t tail;  // IV bytes 8-11
+  };
+  struct Stream {
+    uint32_t ssrc;
+    uint32_t newest;
+    std::vector<Seen> seen;
+    uint64_t last_heard;
+    bool behind;
+    int64_t behind_since_ms;
+  };
+
+  static uint32_t Read32(std::span<const uint8_t> iv, size_t at) {
+    return (uint32_t{iv[at]} << 24) | (uint32_t{iv[at + 1]} << 16) |
+           (uint32_t{iv[at + 2]} << 8) | uint32_t{iv[at + 3]};
+  }
+
+  Stream Start(uint32_t ssrc, uint32_t ts, uint32_t tail) const {
+    return Stream{ssrc, ts, {Seen{ts, tail}}, clock_, false, 0};
+  }
+
+  Stream* Find(uint32_t ssrc) {
+    for (Stream& stream : streams_) {
+      if (stream.ssrc == ssrc) {
+        return &stream;
+      }
+    }
+    return nullptr;
+  }
+
+  std::vector<Stream> streams_;
+  uint64_t clock_ = 0;
+};
+
+}  // namespace webrtc
+
+#endif  // API_CRYPTO_FRAME_REPLAY_GUARD_H_

-zip --symlinks -9 -r "$FRAMEWORK_NAME.xcframework.zip" "$FRAMEWORK_NAME.xcframework"
+python3 - "$FRAMEWORK_NAME.xcframework/Info.plist" <<'PLIST'
+import plistlib, sys
+path = sys.argv[1]
+with open(path, "rb") as f:
+    info = plistlib.load(f)
+info["AvailableLibraries"].sort(key=lambda library: library["LibraryIdentifier"])
+with open(path, "wb") as f:
+    plistlib.dump(info, f, fmt=plistlib.FMT_XML, sort_keys=True)
+PLIST

+# A Catalyst framework is a versioned bundle. Upstream moves the binary into Versions/A after
+# lipo replaced its top-level symlink with a file; with no lipo here the copy keeps the symlink, so
+# this only runs if the binary is a plain file.
+catalyst_framework="$OUT_DIR/$FRAMEWORK_NAME.xcframework/ios-arm64-maccatalyst/$FRAMEWORK_NAME.framework"
+if [[ -f "$catalyst_framework/$FRAMEWORK_NAME" && ! -L "$catalyst_framework/$FRAMEWORK_NAME" ]]; then
+  mv "$catalyst_framework/$FRAMEWORK_NAME" "$catalyst_framework/Versions/A/$FRAMEWORK_NAME"
+  ln -s "Versions/Current/$FRAMEWORK_NAME" "$catalyst_framework/$FRAMEWORK_NAME"
+fi
 
+# honeycomb (D82): a normalised zip (fixed times, sorted entries, no extra attributes), so two
